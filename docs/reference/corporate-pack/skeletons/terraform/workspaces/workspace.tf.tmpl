# Pack: 2026-11-27.1 — illustrative skeleton; placeholders only.
# Contract: docs/reference/corporate-pack/spec/0002-contract.md §3, §5, §7.

# ---------------------------------------------------------------------------------------------
# The workspace container. capacity_id is a Fabric GUID from the data source; the ARM resource
# ID is rejected at plan time.
# ---------------------------------------------------------------------------------------------

resource "fabric_workspace" "this" {
  display_name = var.workspace_name # fabric-<domain>-<env>, unique in the tenant by API rule
  description  = var.workspace_description
  capacity_id  = data.fabric_capacity.shared.id

  # Conditional SystemAssigned identity. The schema models identity as an ATTRIBUTE, not a block,
  # so this is a conditional value rather than a dynamic block.
  # VERIFY: that `identity = null` removes an existing identity in place, and that adding one to
  # an existing workspace does not force replacement. The schema shows no ForceNew; that is not proof.
  identity = local.identity_enabled ? { type = "SystemAssigned" } : null

  lifecycle {
    # Restoring from soft delete does NOT restore the identity (new app/SP IDs), so every Azure
    # RBAC assignment or connection that referenced it is stale. Retire by keeping the block and
    # handing off with removed { lifecycle { destroy = false } }; deleting the block bypasses this.
    prevent_destroy = true
  }
}

# ---------------------------------------------------------------------------------------------
# Three group grants, one per role. The reference builds the edge group -> workspace -> grant,
# so a missing group fails plan rather than apply. Roles are never Admin for people (ADR 0006).
# ---------------------------------------------------------------------------------------------

resource "fabric_workspace_role_assignment" "viewers" {
  workspace_id = fabric_workspace.this.id
  role         = "Viewer"

  principal = {
    id   = azuread_group.viewers.object_id
    type = "Group"
  }
}

resource "fabric_workspace_role_assignment" "contributors" {
  workspace_id = fabric_workspace.this.id
  role         = "Contributor"

  principal = {
    id   = azuread_group.contributors.object_id
    type = "Group"
  }
}

resource "fabric_workspace_role_assignment" "members" {
  workspace_id = fabric_workspace.this.id
  role         = "Member"

  principal = {
    id   = azuread_group.members.object_id
    type = "Group"
  }
}

# The identity's own workspace role. Trusted workspace access expects Contributor; without a role
# the identity can hold storage permissions and still get no token.
#
# A DIRECT service-principal grant, which ADR 0006 refuses for people. The exception is written
# down: this principal is a workload owned by the workspace, has no human membership to delegate,
# and its life must end with the workspace.
resource "fabric_workspace_role_assignment" "identity" {
  count = local.identity_enabled ? 1 : 0

  workspace_id = fabric_workspace.this.id
  role         = "Contributor"

  principal = {
    id   = fabric_workspace.this.identity.service_principal_id
    type = "ServicePrincipal"
  }
}

# ---------------------------------------------------------------------------------------------
# Optional: Azure RBAC for a firewall-enabled storage account. The grant must be at account
# scope; a folder-level grant does not satisfy trusted workspace access.
# ---------------------------------------------------------------------------------------------

resource "azurerm_role_assignment" "identity_storage" {
  count = local.identity_enabled && var.identity_storage_account_id != "" ? 1 : 0

  scope                = var.identity_storage_account_id # ARM ID passed in; never an ambient name
  role_definition_name = "Storage Blob Data Contributor"
  principal_id         = fabric_workspace.this.identity.service_principal_id
}

