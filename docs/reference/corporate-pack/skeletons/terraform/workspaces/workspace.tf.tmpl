# ---------------------------------------------------------------------------------------------
# NONPROD ONLY: the Git binding. `bind_git = false` in prod (ADR 0005). prod is a deployment
# targets whose only way in is the pipeline, so a portal edit is overwritten, not resurrected.
# The resource precondition below refuses bind_git = true when environment is prod.
# ---------------------------------------------------------------------------------------------

resource "fabric_workspace_git" "nonprod" {
  count = var.bind_git ? 1 : 0

  workspace_id = fabric_workspace.this.id

  # PreferWorkspace, NOT PreferRemote. This resource is not importable, so adoption runs the
  # create path, which initialises from the branch; PreferRemote can overwrite the workspace's
  # items with the branch. PreferWorkspace never does.
  initialization_strategy = "PreferWorkspace"

  # v1.15.1 models the repository as an attribute object, not a block. directory_name must start
  # with "/". The repository name is fixed by contract §3.
  git_provider_details = {
    git_provider_type = "AzureDevOps"
    organization_name = var.ado_organization
    project_name      = var.ado_project
    repository_name   = "fabric-${var.domain}-nonprod"
    branch_name       = var.git_branch
    directory_name    = "/"
  }

  # Required since v1.6.0. An SP is supported only with ConfiguredConnection.
  git_credentials = {
    source        = "ConfiguredConnection"
    connection_id = var.git_connection_id # PLACEHOLDER ADO connection GUID
  }

  # A Terraform-created binding both binds AND syncs; it is a writer, not a passive pointer.
  lifecycle {
    # Cross-field guard: the variable validation can only see bind_git itself on Terraform 1.8.
    # With bind_git false this instance does not exist, so the guard costs nothing in prod.
    precondition {
      condition     = var.environment == "nonprod"
      error_message = "bind_git may only be true when environment is nonprod; prod stays unbound (ADR 0005)."
    }
  }
}
