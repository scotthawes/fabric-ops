# corporate-pack 2026-11-26 — ILLUSTRATIVE SKELETON. Never applied from fabric-ops (ADR 0001).
# Pack: 2026-11-26.2 — illustrative skeleton; placeholders only.
# Contract: docs/reference/corporate-pack/spec/0002-contract.md §5.

variable "fabric_administrator_confirmed" {
  type        = bool
  default     = false
  description = "Human confirmation that sp-fabric-admin holds Fabric administrator. false blocks the root at plan via the guard resource."
}

variable "domains" {
  type = map(object({
    display_name  = string
    description   = string
    parent_domain = string # "" for a top-level domain, else another key in this map
    admins = list(object({
      id   = string
      type = string # User | Group | EntireTenant
    }))
    contributors = list(object({
      id   = string
      type = string
    }))
  }))
  description = "One entry per config/domains.yaml row. Map key is the lowercase hyphenated domain name."

  validation {
    condition = alltrue([
      for key, domain in var.domains :
      can(regex("^[a-z0-9]+(-[a-z0-9]+)*$", key)) &&
      length(domain.display_name) > 0 &&
      length(domain.display_name) <= 40
    ])
    error_message = "Domain keys must be lowercase hyphenated and display names must be 1..40 characters."
  }

  validation {
    condition = alltrue([
      for key, domain in var.domains :
      domain.parent_domain == "" || contains(keys(var.domains), domain.parent_domain)
    ])
    error_message = "parent_domain must be empty or the key of another domain in the same map."
  }

  validation {
    condition = alltrue(flatten([
      for key, domain in var.domains : concat(
        [for principal in domain.admins : contains(["User", "Group", "EntireTenant"], principal.type)],
        [for principal in domain.contributors : contains(["User", "Group", "EntireTenant"], principal.type)]
      )
    ]))
    error_message = "Domain principal.type must be one of User, Group, EntireTenant."
  }
}

variable "tenant_id" {
  type        = string
  description = "Entra tenant ID. Guid; not a secret."
}

variable "admin_client_id" {
  type        = string
  description = "Application (client) ID of sp-fabric-admin, which must hold Fabric administrator."
}

variable "ado_service_connection_id" {
  type        = string
  description = "GUID of sc-fabric-admin — the connection ID, never its display name."
}
